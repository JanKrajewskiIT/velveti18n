{
  "name": "@jankrajewskiit/i18n",
  "version": "2.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Headless, type-safe i18n framework for SolidJS: locale management, ICU MessageFormat, rich-text translation, and Intl formatting.",
  "keywords": [
    "solidjs",
    "solid",
    "i18n",
    "internationalization",
    "localization",
    "icu",
    "messageformat",
    "intl",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankrajewskiit/i18n.git"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=26"
  },
  "prettier": "@jankrajewskiit/configs/prettier",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "package-check": "publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run package-check",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "peerDependencies": {
    "solid-js": ">=1.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@jankrajewskiit/configs": "^2.0.2",
    "eslint": ">=9.0.0",
    "husky": "^9.0.0",
    "lint-staged": ">=17.0.0",
    "prettier": ">=3.0.0",
    "publint": "^0.3.0",
    "solid-js": ">=1.9",
    "stylelint": ">=17.14.1",
    "typescript": ">=5.5.0",
    "vite": ">=6.0.0"
  }
}
