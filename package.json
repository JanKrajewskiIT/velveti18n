{
  "name": "@jankrajewskiit/i18n",
  "version": "2.0.9",
  "description": "Type-safe, reactive internationalization for SolidJS.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankrajewskiit/VelvetI18n.git"
  },
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "solidjs",
    "i18n",
    "internationalization",
    "typescript",
    "icu-messageformat"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0 <2"
  },
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run build && publint --strict && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "build": "vite build",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run verify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/configs": "^3.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "solid-js": "^1.9.16",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "eslint": "$eslint"
  },
  "prettier": "@jankrajewskiit/configs/prettier"
}
